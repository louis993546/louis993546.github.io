<script>
const envStatus = document.getElementById('hdr-env-status');
if (envStatus && window.matchMedia) {
    const hdr = window.matchMedia('(dynamic-range: high)').matches;
    const p3 = window.matchMedia('(color-gamut: p3)').matches;
    envStatus.textContent = `Browser display check — dynamic-range: high = ${hdr}, color-gamut: p3 = ${p3}`;
}

document.querySelectorAll('.copy-license-btn').forEach(btn => {
    const copyHandler = async () => {
        const plainText = 'Photo by Louis Tsai (https://louis993546.com/) / CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/)';
        const htmlText = 'Photo by <a href="https://louis993546.com/">Louis Tsai</a> / <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>';

        try {
            if (navigator.clipboard && window.ClipboardItem) {
                const blobHtml = new Blob([htmlText], { type: 'text/html' });
                const blobPlain = new Blob([plainText], { type: 'text/plain' });
                await navigator.clipboard.write([
                    new ClipboardItem({
                        'text/html': blobHtml,
                        'text/plain': blobPlain
                    })
                ]);
            } else if (navigator.clipboard) {
                await navigator.clipboard.writeText(plainText);
            } else {
                const tempInput = document.createElement('textarea');
                tempInput.value = plainText;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
            }

            btn.textContent = '✅';
            btn.setAttribute('title', 'Copied!');

            setTimeout(() => {
                btn.textContent = '📋';
                btn.setAttribute('title', 'Copy attribution');
            }, 2000);
        } catch (err) {
            console.error('Failed to copy: ', err);
        }
    };

    btn.addEventListener('click', copyHandler);
    btn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            copyHandler();
        }
    });
});
</script>
